# Скопируйте этот файл в .env и заполните, чтобы FireAI работал на настоящем LLM.
# Без .env бот работает в демо-режиме ( офлайн-движок ).

# Провайдер: подходит любой OpenAI-совместимый API
# Mistral:  https://api.mistral.ai/v1        (модель: mistral-large-latest)
# OpenAI:   https://api.openai.com/v1        (модель: gpt-4o-mini)
# Ollama:   http://localhost:11434/v1        (модель: llama3.1, ключ не нужен)
FIREAI_BASE_URL=https://api.mistral.ai/v1
FIREAI_API_KEY=
FIREAI_MODEL=mistral-large-latest

# Порт веб-сервера FireAI
PORT=3000

# Ключ, который защищает собственный API FireAI (::/v1/chat/completions)
# Клиенты передают его в заголовке Authorization: Bearer <FIREAI_ACCESS_TOKEN>
# Оставьте пустым, если API должен быть открыт без пароля (только для локальной разработки).
FIREAI_ACCESS_TOKEN=
